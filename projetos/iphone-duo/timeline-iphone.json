  "scenes": [
    {
      "id": "s01_layers",
      "tag": "curious",
      "text": "Você sabia que a tela do iPhone Duo tem dez camadas e mais de cem peças só na dobradiça?",
      "keyBeats": {
        "iPhone Duo": 80,
        "dez": 134,
        "camadas": 161,
        "cem": 216,
        "peças": 250,
        "dobradiça": 294
      },
      "visual": "Slow reveal (curious): 10 glowing planes fade in one by one from 'dez', drift apart along Z. HUD counter rolls 0→10 on 'dez', then 0→100+ on 'cem'. Soft camera, no hard cuts. On 'dobradiça' a faint hinge silhouette glints under the stack.",
      "sfx": [
        {
          "name": "digital counter tick (roll 0→10)",
          "frame": 134
        },
        {
          "name": "digital counter tick (roll 0→100+)",
          "frame": 216
        }
      ],
      "images": [
        "fold_pixel_fold.webp (faint backplate, 15% opacity, hook frame only)"
      ],
      "from": 0,
      "to": 355,
      "voiceFrom": 9
    },
    {
      "id": "s02_oled_ignite",
      "tag": "conversational",
      "text": "Pois é. A mágica começa no OLED.",
      "keyBeats": {
        "Pois é": 361,
        "mágica": 419,
        "OLED": 488
      },
      "visual": "Relaxed drift (conversational). Camera eases toward one pixel of the stack; on 'OLED' it ignites with a bloom burst and a wave of neighbours lights up across the grid.",
      "sfx": [
        {
          "name": "power on chime",
          "frame": 488
        }
      ],
      "images": [
        "oled_subpixels.webp (revealed under the igniting grid)"
      ],
      "from": 355,
      "to": 533,
      "voiceFrom": 361
    },
    {
      "id": "s03_self_emissive",
      "tag": "matter-of-fact",
      "text": "Diferente das telas antigas, aqui cada pixel gera a própria luz.",
      "keyBeats": {
        "telas antigas": 578,
        "pixel": 673,
        "própria luz": 757
      },
      "visual": "Clean HUD (matter-of-fact). Macro RGB sub-pixel grid pulsing; data card 'OLED = cada pixel emite luz'. Cross-section slice shows emitter layer with NO backlight below.",
      "sfx": [
        {
          "name": "electric sparkle",
          "frame": 757
        }
      ],
      "images": [
        "oled_s22_rgb_matrix.webp (macro, Ken Burns)",
        "oled_structure_diagram.webp (faint diagram texture in data card)"
      ],
      "from": 533,
      "to": 781,
      "voiceFrom": 539
    },
    {
      "id": "s04_no_backlight",
      "tag": "matter-of-fact",
      "text": "Não existe aquela placa rígida de backlight por trás. Por isso ela consegue dobrar.",
      "keyBeats": {
        "placa rígida": 848,
        "backlight": 895,
        "dobrar": 1037
      },
      "visual": "Split screen LCD | OLED. LCD half: bright white backlight plate that flickers and powers off on 'backlight'. OLED half: black void with self-lit pixels. On 'dobrar' the OLED half bends smoothly; the LCD half stays rigid.",
      "sfx": [
        {
          "name": "power off",
          "frame": 895
        }
      ],
      "images": [
        "lcd_backlight_leds.webp (LCD half)",
        "lcd_layer_layout.webp (HUD inset, LCD layer diagram)"
      ],
      "from": 781,
      "to": 1064,
      "voiceFrom": 787
    },
    {
      "id": "s05a_not_only",
      "tag": "serious",
      "text": "Mas não é só isso.",
      "keyBeats": {
        "Mas": 1070,
        "isso": 1119
      },
      "visual": "Serious beat: everything dims to ~40%, slow dolly back, layer stack re-forms in silhouette. No SFX, the pause carries it.",
      "sfx": [],
      "images": [],
      "from": 1064,
      "to": 1157,
      "voiceFrom": 1070
    },
    {
      "id": "s05_glass_titanium",
      "tag": "matter-of-fact",
      "text": "Por cima e por baixo da tela tem vidros ultratinhos. E bem no fundo uma placa de titânio.",
      "keyBeats": {
        "por cima": 1171,
        "por baixo": 1210,
        "vidros": 1279,
        "ultratinhos": 1306,
        "bem no fundo": 1396,
        "titânio": 1462
      },
      "visual": "Exploded view, camera orbit. Glass panes slide in above ('cima') and below ('baixo') the OLED with refraction; HUD labels 'UTG · vidro ultrafino'. On 'titânio' a metallic specular plate slides in at the bottom with a glint sweep. Label 'Ti · placa de suporte'.",
      "sfx": [
        {
          "name": "metal shing (glass)",
          "frame": 1279
        },
        {
          "name": "metal shing (titanium)",
          "frame": 1462
        }
      ],
